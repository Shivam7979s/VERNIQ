{
  "name": "verniq-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "VERNIQ — Production-grade engineering learning and career platform",
  "workspaces": [
    "frontend",
    "backend/*"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "lint": "npm --workspace=frontend run lint",
    "typecheck": "npm --workspace=frontend run typecheck",
    "dataset:check": "python -m backend.importer.cli check-dirs",
    "dataset:validate": "python -m backend.importer.cli validate",
    "dataset:report": "python -m backend.importer.cli report"
  },
  "keywords": [
    "verniq",
    "engineering",
    "learning-platform",
    "dsa",
    "code-judge",
    "system-design"
  ],
  "author": "VERNIQ Core Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2"
  }
}
