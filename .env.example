# ==============================================================================
# VERNIQ Environment Variables Template
# Copy this file to .env or apps/web/.env.local for local development.
# NEVER commit secret keys or production service role keys to version control.
# ==============================================================================

# Supabase Public API (Accessible from browser)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Service (FastAPI)
VITE_AI_SERVICE_URL=http://127.0.0.1:8000

# Online Judge API Gateway (Future Phase integration)
VITE_JUDGE_SERVICE_URL=http://127.0.0.1:8080

# Environment / Feature Flags
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
